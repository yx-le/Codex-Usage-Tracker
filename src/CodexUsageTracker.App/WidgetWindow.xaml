<Window x:Class="CodexUsageTracker.App.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexUsageTracker.App" Title="Codex quota indicator" Width="96" Height="96" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False" PreviewMouseLeftButtonDown="PointerDown" PreviewMouseMove="PointerMove" PreviewMouseLeftButtonUp="PointerUp">
  <Button ToolTipService.IsEnabled="False" Click="OpenDetails" AutomationProperties.Name="Open Codex quota details" Padding="0" Margin="2" Width="92" Height="92" Background="Transparent" BorderBrush="Transparent" Cursor="Hand">
    <Button.Clip><EllipseGeometry Center="46,46" RadiusX="46" RadiusY="46"/></Button.Clip>
    <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
    <Grid Width="92" Height="92">
      <Ellipse Fill="{DynamicResource GlassStrongBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="0.5"/>
      <local:QuotaRing x:Name="Ring" Five="{Binding FiveValue}" Week="{Binding WeekValue}" FiveBrush="{Binding FiveBrush}" WeekBrush="{Binding WeekBrush}" FiveExhausted="{Binding FiveExhausted}" WeekExhausted="{Binding WeekExhausted}" Margin="3"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FiveRemaining}" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding WidgetStatus}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding OverallBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Button>
</Window>
