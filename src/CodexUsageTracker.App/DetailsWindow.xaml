<Window x:Class="CodexUsageTracker.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage Tracker" Width="360" Height="500"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="{DynamicResource BackgroundBrush}" ShowInTaskbar="False" Topmost="True"
        KeyDown="OnKeyDown">
  <Border Background="{DynamicResource GlassBrush}" CornerRadius="24">
    <Grid>
      <Grid x:Name="UsagePage">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="DragWindow">
          <Button HorizontalAlignment="Right" Width="30" Height="30" Margin="0,3,8,3" Padding="0" Background="Transparent" Content="×" FontSize="21" FontWeight="Light" ToolTip="Collapse" AutomationProperties.Name="Collapse usage details" Click="Collapse"/>
        </Grid>
        <ScrollViewer x:Name="UsageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
          <StackPanel x:Name="UsageContent" Margin="18,0,11,12">
            <Grid Margin="0,0,0,14">
              <TextBlock Text="Quota remaining" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="↻" IsEnabled="{Binding CanRefresh}" ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="Refresh quota" Click="Refresh" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" FontSize="18" Background="{DynamicResource CardBrush}"/>
            </Grid>
            <Border Visibility="{Binding WarningVisibility}" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12,9" Margin="0,0,0,10">
              <TextBlock Text="{Binding WarningText}" Foreground="{Binding OverallBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="5-HOUR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                  <TextBlock Text="{Binding FiveRemaining}" FontSize="34" FontWeight="SemiBold"/>
                  <TextBlock Text="remaining" FontSize="11" Margin="8,0,0,7" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <ProgressBar Value="{Binding FiveValue, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0" Background="{Binding FiveTrackBrush}" Foreground="{Binding FiveBrush}"/>
                <TextBlock Text="{Binding FiveReset}" Margin="0,10,0,0" FontSize="12"/>
                <TextBlock Text="{Binding FiveResetDate}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="WEEKLY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                  <TextBlock Text="{Binding WeekRemaining}" FontSize="34" FontWeight="SemiBold"/>
                  <TextBlock Text="remaining" FontSize="11" Margin="8,0,0,7" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <ProgressBar Value="{Binding WeekValue, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0" Background="{Binding WeekTrackBrush}" Foreground="{Binding WeekBrush}"/>
                <TextBlock Text="{Binding WeekReset}" Margin="0,10,0,0" FontSize="12"/>
                <TextBlock Text="{Binding WeekResetDate}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="2,2,2,0" ToolTip="{Binding SourceDetail}">
              <TextBlock Text="{Binding LastUpdated}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding OverallBrush}" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Settings" Click="Settings" Margin="18,2,18,12"/>
      </Grid>
      <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
    </Grid>
  </Border>
</Window>
