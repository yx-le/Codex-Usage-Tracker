<Window x:Class="CodexUsageTracker.App.DetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexUsageTracker.App" Title="Codex Usage Tracker" Width="420" Height="790" MinWidth="380" MinHeight="420" Background="{DynamicResource BackgroundBrush}" WindowStyle="ToolWindow" ShowInTaskbar="False" Topmost="True" KeyDown="OnKeyDown">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,16,24,16">
      <DockPanel><TextBlock Text="CODEX" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="USAGE TRACKER" Margin="8,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
      <DockPanel Margin="0,14,0,4"><TextBlock Text="Room to build." FontSize="28" FontWeight="SemiBold"/><Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"/></Border></DockPanel>
      <TextBlock Text="Your remaining Codex quota, at a glance." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
        <StackPanel><DockPanel><TextBlock Text="5-HOUR LIMIT" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding FiveUsed}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,10"><TextBlock Text="{Binding FiveRemaining}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="remaining" Margin="8,0,0,7" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          <ProgressBar Value="{Binding FiveValue, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="{Binding FiveReset}" Margin="0,8,0,4"/><TextBlock Text="{Binding FivePace}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16">
        <StackPanel><DockPanel><TextBlock Text="WEEKLY LIMIT" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WeekUsed}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,10"><TextBlock Text="{Binding WeekRemaining}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="remaining" Margin="8,0,0,7" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          <ProgressBar Value="{Binding WeekValue, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource WeekBrush}"/>
          <TextBlock Text="{Binding WeekReset}" Margin="0,8,0,4"/><TextBlock Text="{Binding WeekPace}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </Border>
      <DockPanel><TextBlock Text="LAST 7 DAYS" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Remaining %" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></DockPanel>
      <local:HistoryChart x:Name="Chart" Height="84" Margin="0,10,0,4"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="● 5-hour" Foreground="{DynamicResource AccentBrush}" FontSize="10"/><TextBlock Text="● Weekly" Foreground="{DynamicResource WeekBrush}" FontSize="10" Margin="16,0,0,0"/></StackPanel>

      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
        <StackPanel><TextBlock Text="{Binding SourceDetail}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding LastUpdated}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="{Binding Connection}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="{Binding StorageStatus}" TextWrapping="Wrap" Foreground="#DF8C36" FontSize="10"/></StackPanel>
      </Border>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding RefreshLabel}" Click="Refresh"/><Button Grid.Column="2" Content="Settings" Click="Settings"/></Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
