<UserControl x:Class="CodexUsageTracker.App.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
  <Border Background="Transparent">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragWindow">
        <TextBlock Text="Settings" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
        <Button Content="← Back" Click="Cancel" AutomationProperties.Name="Back to usage" HorizontalAlignment="Right" Height="34" Margin="0,7,12,7" Background="Transparent"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
        <StackPanel Margin="22,8,15,22">
          <TextBlock Text="VISIBILITY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="14" Margin="0,8,0,16">
            <StackPanel><CheckBox x:Name="Startup" Content="Launch tracker at Windows sign-in" Click="ChangeStartup"/><TextBlock Text="Starts quietly; the circle appears when Codex opens. This option saves immediately." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/><CheckBox x:Name="OnlyRunning" Content="Show widget only while Codex is running"/><CheckBox x:Name="Floating" Content="Enable floating circle"/><TextBlock Text="The tray icon stays available when the circle is hidden." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <CheckBox x:Name="TrayNumber" Content="Show remaining % in taskbar tray icon"/><ComboBox x:Name="TrayWindow" Margin="0,4,0,8"><ComboBoxItem Content="5-hour"/><ComboBoxItem Content="Weekly"/></ComboBox><TextBlock Text="Move the icon out of the Windows overflow menu to keep it visible." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><CheckBox x:Name="EdgeEnabled" Content="Enable slim edge bar"/><ComboBox x:Name="EdgeChoice" Margin="0,4,0,8"><ComboBoxItem Content="Top"/><ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/></ComboBox><TextBlock Text="Drag along the edge to reposition; click for details. Turn off the floating circle above for a clear desktop." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/><TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <ComboBox x:Name="ThemeChoice" SelectedIndex="0" Margin="0,8,0,16"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
          <TextBlock Text="ALERTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="14" Margin="0,8,0,16">
            <StackPanel>
              <CheckBox x:Name="Alerts" Content="Enable low-quota notifications" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Warning remaining (%)" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="Warning" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Critical remaining (%)" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="Critical" Margin="0,6,0,0"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="CODEX SOURCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="Executable"/></DockPanel>
          <TextBlock Text="Leave blank to find Codex automatically. Your existing sign-in is used; no API key is needed." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,16"/>
          <TextBlock Text="PRIVACY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Text="Quota readings stay on this PC for 7 days. No telemetry, browser cookies, prompts, or responses are stored." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/>
          <Button Content="Clear local history" Click="ClearHistory" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          <TextBlock x:Name="Validation" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        </StackPanel>
      </ScrollViewer>
<Button Click="Save" Grid.Row="2" Margin="22,4,22,14" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"><TextBlock Text="Save settings" Foreground="{DynamicResource AccentTextBrush}"/></Button>
    </Grid>
  </Border>
</UserControl>
