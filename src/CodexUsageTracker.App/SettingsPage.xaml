<UserControl x:Class="CodexUsageTracker.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,18,0,4"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="10,12"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="DragWindow">
      <TextBlock Text="Settings" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
      <Button Content="← Back" Click="Cancel" AutomationProperties.Name="Back to usage" HorizontalAlignment="Right" Height="34" Margin="0,9,12,9" Background="Transparent"/>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
      <StackPanel x:Name="SettingsContent" Margin="22,0,15,20">
        <TabControl x:Name="Sections" SelectedIndex="0">
          <TabItem Header="Display">
            <StackPanel>
              <TextBlock Text="Where usage appears" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Choose any combination of displays." Style="{StaticResource Caption}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <CheckBox x:Name="Floating" Content="Circle widget" Margin="0,0,0,0"/>
                <TextBlock Text="Two quota rings in a movable circle. Click for details." Style="{StaticResource Caption}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <CheckBox x:Name="EdgeEnabled" Content="Slim edge bar" Margin="0,0,0,0"/>
                <TextBlock Text="A quiet strip with both quotas. Drag to the top or sides; click for details." Style="{StaticResource Caption}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <CheckBox x:Name="TaskbarEnabled" Content="Windows taskbar" Margin="0,0,0,0"/>
                <TextBlock Text="Quota progress in a taskbar button. Click for details." Style="{StaticResource Caption}"/>
              </StackPanel></Border>
              <TextBlock Text="Launch and visibility" Style="{StaticResource SectionTitle}"/>
              <Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>
                <CheckBox x:Name="Startup" Content="Automatically launch with Codex" Click="ChangeStartup" Margin="0,0,0,0"/>
                <TextBlock Text="Starts a quiet watcher at Windows sign-in." Style="{StaticResource Caption}"/>
                <CheckBox x:Name="OnlyRunning" Content="Show only while Codex is running" Margin="0,16,0,0"/>
                <TextBlock Text="The tray icon remains available." Style="{StaticResource Caption}"/>
              </StackPanel></Border>
            </StackPanel>
          </TabItem>
          <TabItem Header="Appearance">
            <StackPanel>
              <TextBlock Text="Make it yours" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Changes appear immediately." Style="{StaticResource Caption}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Theme" FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeChoice" SelectedIndex="0" Margin="0,10,0,0"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Background transparency" FontWeight="SemiBold"/>
                <TextBlock Text="0% solid · 100% clear. Text stays visible." Style="{StaticResource Caption}" Margin="0,4,0,20"/>
                <DockPanel><TextBlock Text="Circle widget"/><TextBlock x:Name="CircleTransparencyValue" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="CircleTransparency" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,10,0,22" AutomationProperties.Name="Circle background transparency percent"/>
                <DockPanel><TextBlock Text="Slim edge bar"/><TextBlock x:Name="EdgeTransparencyValue" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="EdgeTransparency" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,10,0,22" AutomationProperties.Name="Edge bar background transparency percent"/>
                <DockPanel><TextBlock Text="Details panel"/><TextBlock x:Name="PanelTransparencyValue" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="PanelTransparency" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="0,10,0,0" AutomationProperties.Name="Details background transparency percent"/>
              </StackPanel></Border>
            </StackPanel>
          </TabItem>
          <TabItem Header="Alerts">
            <StackPanel>
              <TextBlock Text="Know when to slow down" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Windows notifications when remaining quota runs low." Style="{StaticResource Caption}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <CheckBox x:Name="Alerts" Content="Low-quota notifications" Margin="0,0,0,18"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Warning (%)"/><TextBox x:Name="Warning" Margin="0,8,0,0" AutomationProperties.Name="Warning remaining percent"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Critical (%)"/><TextBox x:Name="Critical" Margin="0,8,0,0" AutomationProperties.Name="Critical remaining percent"/></StackPanel>
                </Grid>
                <TextBlock Text="Critical must be lower than warning." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </TabItem>
          <TabItem Header="Advanced">
            <StackPanel>
              <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Codex executable" FontWeight="SemiBold"/>
                <TextBlock Text="Leave blank to find Codex automatically." Style="{StaticResource Caption}"/>
                <TextBox x:Name="Executable" Margin="0,12,0,0" AutomationProperties.Name="Codex executable path"/>
                <Button Content="Browse…" Click="Browse" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <TextBlock Text="Uses your existing sign-in. No API key required." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="22,8,22,16">
      <TextBlock x:Name="Validation" Text="Changes save automatically" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
      <Button Click="Save" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"><TextBlock Text="Done" Foreground="{DynamicResource AccentTextBrush}"/></Button>
    </StackPanel>
  </Grid>
</UserControl>
