<Window x:Class="CodexUsageTracker.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tracker settings" Width="440" Height="650" ResizeMode="NoResize" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="Make it yours." FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <CheckBox x:Name="OnlyRunning" Content="Show widget only while Codex is running"/>
    <CheckBox x:Name="Floating" Content="Enable floating circle"/>
    <TextBlock Text="The tray icon stays available when the circle is hidden." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    <TextBlock Text="Appearance" Margin="0,18,0,6"/><ComboBox x:Name="ThemeChoice" SelectedIndex="0"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
    <CheckBox x:Name="Alerts" Content="Enable low-quota notifications" Margin="0,20,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Warning remaining (%)" FontSize="11"/><TextBox x:Name="Warning" Margin="0,6,0,0" Padding="7"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Critical remaining (%)" FontSize="11"/><TextBox x:Name="Critical" Margin="0,6,0,0" Padding="7"/></StackPanel>
    </Grid>
    <TextBlock Text="Codex executable (optional)" Margin="0,20,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse" Margin="8,0,0,0"/><TextBox x:Name="Executable" Padding="6"/></DockPanel>
    <TextBlock Text="Leave blank to find Codex automatically. Uses your existing Codex sign-in; no API key needed." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock Text="Privacy" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <TextBlock Text="Quota readings stay on this PC for 7 days. No telemetry, browser cookies, or prompt/response storage." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    <Button Content="Clear local history" Click="ClearHistory" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    <TextBlock x:Name="Validation" Foreground="#D07924" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <Button Content="Save settings" Click="Save" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
</Window>
